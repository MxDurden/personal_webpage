---
const { pathname } = Astro.url;
---

<nav class="w-full px-6 py-4 border-b border-green-800 bg-black/80 backdrop-blur sticky top-0 z-50 shadow-[0_1px_2px_rgba(0,255,100,0.1)]">
  <div class="max-w-7xl mx-auto flex justify-between items-center font-mono">
    <a href="/" class="text-green-400 text-xl tracking-tight hover:text-white transition duration-150">[ MrDurden.sh ]</a>
    <ul class="flex gap-6 text-sm text-gray-300">
      <li>
        <a href="/resume" class={pathname === '/resume' ? 'text-white font-semibold' : 'hover:text-green-400 hover:underline underline-offset-4'}>
          Resume
        </a>
      </li>
      <li>
        <a href="/projects" class={pathname === '/projects' ? 'text-white font-semibold' : 'hover:text-green-400 hover:underline underline-offset-4'}>
          Projects
        </a>
      </li>
      <li>
        <a href="/toolset" class={pathname === '/toolset' ? 'text-white font-semibold' : 'hover:text-green-400 hover:underline underline-offset-4'}>
          Toolset
        </a>
      </li>
      <li>
        <a href="/experience" class={pathname === '/experience' ? 'text-white font-semibold' : 'hover:text-green-400 hover:underline underline-offset-4'}>
          Experience
        </a>
      </li>
      <li>
        <a href="/blog" class={pathname === '/blog' ? 'text-white font-semibold' : 'hover:text-green-400 hover:underline underline-offset-4'}>
          Blog
        </a>
      </li>
      <li>
        <a href="/about" class={pathname === '/about' ? 'text-white font-semibold' : 'hover:text-green-400 hover:underline underline-offset-4'}>
          About Me
        </a>
      </li>
      <li>
        <a href="/contact" class={pathname === '/contact' ? 'text-white font-semibold' : 'hover:text-green-400 hover:underline underline-offset-4'}>
          Contact
        </a>
      </li>
      <li>
        <a href="/h4x0r" class={`transition duration-150 ease-in-out ${pathname === '/h4x0r' ? 'text-green-400 font-bold animate-pulse' : 'hover:text-green-400'}`}>
          H4x0r
        </a>
      </li>
    </ul>
  </div>
</nav>
