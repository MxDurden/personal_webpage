---
const { pathname } = Astro.url;

const navItems = [
  { href: '/', label: 'home' },
  { href: '/about', label: 'about' },
  { href: '/experience', label: 'experience' },
  { href: '/projects', label: 'projects' },
  { href: '/toolset', label: 'toolset' },
  { href: '/blog', label: 'blog' },
  { href: '/contact', label: 'contact' },
];
---

<nav class="w-full px-6 py-4 bg-darker/95 backdrop-blur-md border-b border-steel-900 sticky top-0 z-50 animate-fade-in-down">
  <div class="max-w-7xl mx-auto flex justify-between items-center">

    <a href="/" class="text-steel-100 font-mono text-sm font-bold hover:text-accent transition-colors duration-300 hidden md:block">
      <span class="text-accent">$</span> isaac@quezada<span class="animate-glow-pulse text-accent">_</span>
    </a>

    <ul class="flex gap-8 font-mono text-sm tracking-wide ml-auto">
      {navItems.map((item, index) => (
        <li class={`animate-fade-in stagger-${index + 1}`}>
          <a
            href={item.href}
            class={`nav-link relative ${
              pathname === item.href
                ? 'text-accent font-bold'
                : 'text-steel-300 hover:text-steel-100'
            }`}
          >
            /{item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, #10b981, #059669);
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }
</style>
