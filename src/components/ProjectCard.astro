---
import IconTech from './IconTech.astro';
const { title, description, link, tags = [] } = Astro.props;
---

<div class="p-6 border border-steel-800 bg-carbon/30 backdrop-blur-sm hover:border-steel-700 transition-all duration-300">
  <h2 class="text-xl font-mono font-bold text-steel-100 mb-3">{title}</h2>
  <p class="text-sm font-mono text-steel-300 mb-5 leading-relaxed">{description}</p>

  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {tags.map(tag => (
        <span class="text-xs font-mono px-2 py-1 bg-steel-900/50 text-steel-400 border border-steel-800">
          {tag}
        </span>
      ))}
    </div>
  )}

  {link !== "#" && (
    <a href={link} target="_blank" rel="noopener noreferrer" class="inline-block mt-4 text-sm font-mono text-accent hover:text-steel-100 transition-colors">
      <span class="text-accent">></span> View Details
    </a>
  )}
</div>
