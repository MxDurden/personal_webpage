---
import IconTech from './IconTech.astro';
const { title, description, link, tags = [] } = Astro.props;
---

<div class="p-6 rounded-xl shadow-lg border border-[#2a2a2a] bg-[#0f172a] hover:scale-[1.02] hover:shadow-blue-400/20 transition-transform duration-200">
  <h2 class="text-xl font-bold text-[#e0e0e0] mb-2">{title}</h2>
  <p class="text-sm text-[#bbbbbb] mb-4">{description}</p>

  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2 mb-4">
      {tags.map(tag => (
        <span class="flex items-center gap-1 bg-[#1e293b] text-blue-300 text-xs font-mono px-2 py-0.5 rounded">
          <IconTech name={tag} />
          {tag}
        </span>
      ))}
    </div>
  )}

  <a href={link} class="text-sm text-blue-400 hover:text-white underline">View Details</a>
</div>
