---
const year = new Date().getFullYear();
const buildTime = new Date().toISOString().split('T')[0];
const isProd = import.meta.env.MODE === 'production';
const commitHash = isProd ? import.meta.env.VERCEL_GIT_COMMIT_SHA?.slice(0, 7) : null;
---

<footer class="w-full py-8 px-4 text-sm text-steel-400 text-center font-mono border-t border-steel-900 bg-darker/50 backdrop-blur-sm animate-fade-in">
  <div class="max-w-7xl mx-auto flex flex-col items-center gap-3">

    <div class="flex items-center gap-2 text-xs">
      <span class="text-accent">▸</span>
      <span>&copy; {year} isaacquezada.dev</span>
      <span class="text-steel-700">|</span>
      <span>
        Infra by
        <a
          href="https://magueylabs.com"
          class="text-accent font-semibold hover:text-accent/80 link-underline transition-colors"
          target="_blank"
          rel="noopener noreferrer"
        >
          MagueyLabs
        </a>
      </span>
    </div>

    <p class="text-xs text-steel-500">
      Served static, privacy-respecting & tracker-free
    </p>

    {isProd && commitHash && (
      <div class="text-xs text-steel-500 flex items-center gap-2">
        <span class="text-accent">◆</span>
        <span>Build: <code class="bg-carbon px-2 py-0.5 rounded text-steel-300">{commitHash}</code></span>
        <span class="text-steel-700">•</span>
        <span>{buildTime}</span>
        <span class="text-steel-700">•</span>
        <button
          onclick="document.getElementById('pgp-modal').classList.remove('hidden')"
          class="text-steel-400 hover:text-accent link-underline transition-colors"
        >
          View PGP key
        </button>
      </div>
    )}
  </div>
</footer>

<!-- 🔐 Modal PGP Key -->
<div id="pgp-modal" class="hidden fixed inset-0 bg-black/90 backdrop-blur-md flex items-center justify-center z-50 animate-fade-in">
  <div class="bg-dark border border-steel-700 p-6 rounded-xl max-w-3xl w-full mx-4 text-left text-xs font-mono text-steel-200 relative shadow-steel-lg animate-fade-in-up">

    <div class="flex justify-between items-center mb-4 pb-3 border-b border-steel-800">
      <h3 class="text-base font-semibold text-steel-100">
        <span class="text-accent">$</span> PGP Public Key
      </h3>

      <button
        onclick="document.getElementById('pgp-modal').classList.add('hidden')"
        class="text-steel-400 hover:text-red-500 text-xl transition-colors"
      >
        ✕
      </button>
    </div>

    <div class="mb-4 flex gap-3 justify-end">
      <button
        onclick="navigator.clipboard.writeText(document.getElementById('pgp-key').innerText)"
        class="px-4 py-2 bg-carbon border border-steel-700 rounded-lg hover:border-accent hover:text-accent transition-all text-xs"
        title="Copy to clipboard"
      >
        Copy
      </button>
      <a
        href="/keys/public.asc"
        download
        class="px-4 py-2 bg-accent/10 border border-accent/30 text-accent rounded-lg hover:bg-accent/20 transition-all text-xs"
        title="Download key"
      >
        Download
      </a>
    </div>

