---
const { name } = Astro.props;

const icons = {
  Ansible: "/logos/ansible.svg",
  Apache: "/logos/apache.svg",
  AWS: "/logos/aws.svg",
  Bash: "/logos/bash02.svg",
  Debian: "/logos/debian.svg",
  Docker: "/logos/docker.svg",
  FreeBSD: "/logos/freebsd.svg",
  Gentoo: "/logos/gentoo.svg",
  Gitea: "/logos/gitea.svg",
  GitHub: "/logos/github.svg",
  Jenkins: "/logos/jenkins.svg",
  Kubernetes: "/logos/kubernetes.svg",
  Linux: "/logos/linux.svg",
  Nginx: "/logos/nginx.svg",
  OpenBSD: "/logos/openbsd.svg",
  PostgreSQL: "/logos/postgresql.svg",
  Python: "/logos/python.svg",
  QEMU: "/logos/qemu.svg",
  Redis: "/logos/redis.svg",
  Snort: "/logos/snort.svg",
  Telegram: "/logos/telegram.svg",
  Terraform: "/logos/terraform.svg",
  WireGuard: "/logos/wireguard.svg",
  Windows: "/logos/windows.svg"
};

const iconSrc = icons[name] || null;
---

{iconSrc && (
  <img src={iconSrc} alt={name} title={name} class="w-4 h-4 inline-block align-text-bottom" />
)}
