---
const { name } = Astro.props;

const icons = {
  Ansible: "/icons/ansible.svg",
  Apache: "/icons/apache.svg",
  AWS: "/icons/aws.svg",
  Azure: "/icons/azure.svg",
  Bash: "/icons/bash02.svg",
  Debian: "/icons/debian.svg",
  Docker: "/icons/docker.svg",
  FreeBSD: "/icons/freebsd.svg",
  GCP: "/icons/gcp.svg",
  Gentoo: "/icons/gentoo.svg",
  Gitea: "/icons/gitea.svg",
  GitHub: "/icons/github.svg",
  Jenkins: "/icons/jenkins.svg",
  Kubernetes: "/icons/kubernetes.svg",
  Linux: "/icons/linux.svg",
  Nginx: "/icons/nginx.svg",
  OpenBSD: "/icons/openbsd.svg",
  PostgreSQL: "/icons/postgresql.svg",
  Python: "/icons/python.svg",
  QEMU: "/icons/qemu.svg",
  Redis: "/icons/redis.svg",
  Snort: "/icons/snort.svg",
  Telegram: "/icons/telegram.svg",
  Terraform: "/icons/terraform.svg",
  WireGuard: "/icons/wireguard.svg",
  Windows: "/icons/windows.svg"
};

const iconSrc = icons[name] || null;
---

{iconSrc && (
  <img src={iconSrc} alt={name} title={name} class="w-4 h-4 inline-block align-text-bottom" />
)}
