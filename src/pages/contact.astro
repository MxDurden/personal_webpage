---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Contact | Isaac Quezada";
const description = "Get in touch for freelance, contract, or remote work opportunities. Available for DevOps and cybersecurity consulting projects.";
---

<BaseLayout title={title} description={description}>
  <section class="min-h-screen flex flex-col justify-center items-center text-center px-4">
    <h1 class="text-3xl md:text-5xl font-bold text-accent mb-4 animate-fade-in">
      Let's connect.
    </h1>

    <p class="text-gray-400 text-base md:text-lg max-w-xl mb-6 animate-fade-in-up">
      I'm available for freelance, contract, or remote work opportunities. Feel free to reach out.
    </p>

    <div class="flex flex-wrap justify-center gap-4 mb-10 animate-fade-in-up">
      <a href="https://github.com/MxDurden" target="_blank" class="border border-gray-600 text-gray-300 px-4 py-2 hover:bg-white hover:text-black transition">
        GitHub
      </a>
      <a href="https://www.linkedin.com/in/isaac-quezada-055776105" target="_blank" class="border border-gray-600 text-gray-300 px-4 py-2 hover:bg-white hover:text-black transition">
        LinkedIn
      </a>
    </div>

    <p class="text-sm text-gray-600 animate-fade-in-up">
      Or just drop a line at <a href="mailto:iq@isaacquezada.dev" class="underline hover:text-accent">iq@isaacquezada.dev</a>
    </p>
  </section>
</BaseLayout>
