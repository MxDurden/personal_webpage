---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Notes | Isaac Quezada";
const description = "Quick knowledge drops, config snippets, fixes, and lessons from the field. Technical notes and documentation.";
---

<BaseLayout title={title} description={description}>
  <section class="min-h-screen px-6 py-12 text-white">
    <h1 class="text-4xl font-bold text-gray-100 mb-6">Notes</h1>
    <p class="text-lg text-gray-400 mb-8 max-w-2xl">
      Short knowledge drops, config snippets, fixes, exploits, and lessons from the trenches. Half docs, half brain dump.
    </p>

    <p class="text-gray-500 text-sm italic">Soon this will be filled with commands, hacks, and obscure configs.</p>
  </section>
</BaseLayout>
