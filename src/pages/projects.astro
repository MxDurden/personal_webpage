---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const personalProjects = [
  {
    title: "MagueyGuard",
    description: "Distributed VPN and DNS firewall stack deployed with Terraform and Ansible across multiple VPS. Privacy-focused, no trackers, no logs.",
    link: "#",
    tags: ["WireGuard", "Pi-hole", "Terraform", "Ansible"],
    snippet: "ansible-playbook magueyguard.yml"
  },
  {
    title: "Infra-as-Code Lab",
    description: "Personal lab to test CI/CD pipelines using Jenkins, Terraform, and Linux. Focused on reproducible infrastructure deployments.",
    link: "#",
    tags: ["Terraform", "Ansible", "Jenkins", "Linux"],
    snippet: "terraform apply"
  },
  {
    title: "K8s Homelab",
    description: "Self-hosted cluster built with K3s and MetalLB. GitOps via FluxCD, monitoring with Prometheus, and Telegram alerts.",
    link: "#",
    tags: ["Kubernetes", "GitHub", "Linux", "GitOps"],
    snippet: "kubectl get nodes"
  },
  {
    title: "Secure Bash Scripts",
    description: "Audited shell scripts for encrypted backups, server hardening, and automation across Debian and OpenBSD systems.",
    link: "#",
    tags: ["Linux", "Bash", "Ansible"]
  },
  {
    title: "Infra Templates",
    description: "Reusable Infrastructure-as-Code blueprints for fast and secure deployments on VPS or local environments.",
    link: "#",
    tags: ["Terraform", "Ansible", "Docker"]
  },
  {
    title: "Remote Uptime Monitor",
    description: "Self-hosted uptime checker with Telegram integration. No SaaS dependencies, fully private.",
    link: "#",
    tags: ["Linux", "Redis", "Telegram"]
  }
];

const communityProjects = [
  {
    title: "MagueyMirror",
    description: "Official Debian mirror for LATAM, running on bare-metal with Nginx and rsync. Serves ~25% of Mexico's package traffic.",
    link: "#",
    tags: ["Linux", "Nginx", "Debian"],
    snippet: "rsync -avz debian.org::debian /mirror"
  }
];

const freelanceProjects = [
  {
    title: "Odoo ERP Hardening",
    description: "Security hardening of Odoo CE for an auto parts business with 20K+ SKUs. Includes PostgreSQL tuning and automated backups.",
    link: "#",
    tags: ["Odoo", "PostgreSQL", "Linux", "Ansible"]
  },
  {
    title: "DevOps Toolbox",
    description: "Delivery-ready stack: Nginx, Redis, Docker, and GitHub Actions preconfigured. Includes deployment and backup scripts.",
    link: "#",
    tags: ["Docker", "Nginx", "GitHub", "Redis"]
  }
];

const title = "Projects | Isaac Quezada";
const description = "Personal tools, freelance work, and community contributions focused on automation, infrastructure security, and open-source development.";
---

<BaseLayout title={title} description={description}>
  <section class="container mx-auto px-6 py-16 space-y-16">
    <div class="space-y-4">
      <h1 class="text-4xl md:text-5xl font-mono font-bold text-steel-100">
        <span class="text-accent">></span> Projects
      </h1>
      <p class="text-lg text-steel-300 max-w-3xl font-mono leading-relaxed">
        A curated list of personal tools, freelance work, and community contributions — focused on automation, infrastructure, security, and open-source development.
      </p>
    </div>

    <div class="space-y-12">
      <div class="space-y-8">
        <h2 class="text-2xl font-mono font-semibold text-steel-200 border-b border-steel-800 pb-3">
          Personal Projects
        </h2>
        <div class="grid gap-8 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
          {personalProjects.map(project => (
            <ProjectCard {...project} />
          ))}
        </div>
      </div>

      <div class="space-y-8">
        <h2 class="text-2xl font-mono font-semibold text-steel-200 border-b border-steel-800 pb-3">
          Community Contributions
        </h2>
        <div class="grid gap-8 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
          {communityProjects.map(project => (
            <ProjectCard {...project} />
          ))}
        </div>
      </div>

      <div class="space-y-8">
        <h2 class="text-2xl font-mono font-semibold text-steel-200 border-b border-steel-800 pb-3">
          Freelance / Client Work
        </h2>
        <div class="grid gap-8 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
          {freelanceProjects.map(project => (
            <ProjectCard {...project} />
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
