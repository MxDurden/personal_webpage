---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const allCategories = [...new Set(sortedPosts.map(post => post.data.category))];
const allTags = [...new Set(sortedPosts.flatMap(post => post.data.tags))];

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  }).format(date);
};

const categoryColors = {
  tech: "text-accent border-accent/30 bg-accent/10",
  notes: "text-blue-400 border-blue-400/30 bg-blue-400/10",
  life: "text-purple-400 border-purple-400/30 bg-purple-400/10",
};
---

<BaseLayout>
  <section class="container mx-auto px-6 md:px-12 py-12">
    <div class="max-w-6xl mx-auto">
      <header class="mb-12">
        <h1 class="text-4xl md:text-5xl font-bold text-steel-100 mb-4 font-mono">
          <span class="text-accent">//</span> Blog
        </h1>
        <p class="text-lg text-steel-300 max-w-2xl">
          Technical writings, operational notes, and reflections on building secure and reliable systems.
        </p>
      </header>

      <div class="mb-8" x-data="{ search: '', selectedCategory: 'all', selectedTag: 'all' }">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
          <div>
            <label for="search" class="block text-sm font-mono text-steel-400 mb-2">Search</label>
            <input
              type="text"
              id="search"
              x-model="search"
              placeholder="Search posts..."
              class="w-full px-4 py-2 bg-carbon border border-steel-800 rounded-lg text-steel-200 placeholder-steel-600 focus:outline-none focus:border-accent/50 font-mono text-sm"
            />
          </div>

          <div>
            <label for="category" class="block text-sm font-mono text-steel-400 mb-2">Category</label>
            <select
              id="category"
              x-model="selectedCategory"
              class="w-full px-4 py-2 bg-carbon border border-steel-800 rounded-lg text-steel-200 focus:outline-none focus:border-accent/50 font-mono text-sm"
            >
              <option value="all">All Categories</option>
              {allCategories.map(cat => (
                <option value={cat}>{cat}</option>
              ))}
            </select>
          </div>

          <div>
            <label for="tag" class="block text-sm font-mono text-steel-400 mb-2">Tag</label>
            <select
              id="tag"
              x-model="selectedTag"
              class="w-full px-4 py-2 bg-carbon border border-steel-800 rounded-lg text-steel-200 focus:outline-none focus:border-accent/50 font-mono text-sm"
            >
              <option value="all">All Tags</option>
              {allTags.map(tag => (
                <option value={tag}>#{tag}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="space-y-6">
          {sortedPosts.map((post) => (
            <article
              class="post-card p-6 bg-carbon/50 border border-steel-900 rounded-lg hover:border-steel-700 transition-all duration-300"
              data-title={post.data.title.toLowerCase()}
              data-description={post.data.description.toLowerCase()}
              data-category={post.data.category}
              data-tags={post.data.tags.join(',')}
              x-show="(selectedCategory === 'all' || selectedCategory === $el.dataset.category) &&
                      (selectedTag === 'all' || $el.dataset.tags.split(',').includes(selectedTag)) &&
                      (search === '' || $el.dataset.title.includes(search.toLowerCase()) || $el.dataset.description.includes(search.toLowerCase()))"
            >
              <div class="flex flex-wrap gap-3 items-center mb-3 text-sm">
                <a
                  href={`/blog/category/${post.data.category}`}
                  class={`px-3 py-1 rounded-lg border font-mono transition-all duration-200 hover:scale-105 ${categoryColors[post.data.category]}`}
                >
                  {post.data.category}
                </a>
                <span class="text-steel-500">•</span>
                <time datetime={post.data.pubDate.toISOString()} class="text-steel-500 font-mono">
                  {formatDate(post.data.pubDate)}
                </time>
              </div>

              <h2 class="text-2xl font-bold text-steel-100 mb-3 font-mono">
                <a href={`/blog/${post.slug}`} class="hover:text-accent transition-colors">
                  {post.data.title}
                </a>
              </h2>

              <p class="text-steel-300 mb-4 leading-relaxed">
                {post.data.description}
              </p>

              <div class="flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <a
                    href={`/blog/tag/${tag}`}
                    class="px-2 py-1 text-xs font-mono text-steel-500 bg-steel-900/50 border border-steel-800 rounded hover:border-accent/50 hover:text-accent transition-all duration-200"
                  >
                    #{tag}
                  </a>
                ))}
              </div>
            </article>
          ))}
        </div>

        <div
          x-show="!document.querySelectorAll('.post-card[x-show]:not([style*=\"display: none\"])').length"
          class="text-center py-12"
        >
          <p class="text-steel-500 font-mono">No posts found matching your filters.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
