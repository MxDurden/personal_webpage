---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Isaac Quezada — DevOps Engineer & CiberSecurity Consultant";
const description = "DevOps and cybersecurity specialist with 20+ years of experience in automation, cloud infrastructure, and secure systems. Focused on building reliable and hardened production environments.";
---

<BaseLayout title={title} description={description}>
  <section class="container mx-auto flex flex-col items-center justify-center flex-1 px-6 md:px-12 py-20 gap-12 text-center relative">

    <div class="absolute inset-0 -z-10 opacity-30">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-accent/5 rounded-full blur-3xl"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-steel-700/10 rounded-full blur-3xl"></div>
    </div>

    <div class="space-y-6 animate-fade-in">
      <h1 class="text-5xl md:text-7xl font-mono font-bold text-steel-100 tracking-tight">
        <span class="text-accent">$</span> isaac@quezada<span class="text-steel-300 animate-glow-pulse">:~</span>
      </h1>

      <div class="h-1 w-32 mx-auto bg-gradient-to-r from-transparent via-steel-600 to-transparent opacity-50"></div>

      <p class="text-lg md:text-xl font-mono text-steel-300 max-w-3xl mx-auto leading-relaxed animate-fade-in-up stagger-1">
        Expert in <span class="text-steel-100 font-semibold">DevOps</span> and <span class="text-steel-100 font-semibold">CiberSecurity</span>.
        Linux, automation, networking, and high-availability systems.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-6xl mt-16 text-left w-full">
      <div class="space-y-6 animate-fade-in-up stagger-2">
        <p class="text-sm font-mono text-steel-300 leading-relaxed">
          <span class="text-accent font-bold">></span> 20+ years building infrastructure for large enterprises and smaller organizations — Windows and Linux, across on-prem, cloud, and virtualized environments (KVM, VMware vSphere/ESXi).
        </p>

        <p class="text-sm font-mono text-steel-300 leading-relaxed">
          <span class="text-accent font-bold">></span> Cybersecurity focus aligned with NIST, CIS Benchmarks, and Australian/UK government standards. Familiar with MITRE ATT&CK and threat modeling.
        </p>

        <p class="text-sm font-mono text-steel-300 leading-relaxed">
          <span class="text-accent font-bold">></span> Applied DevSecOps practices: container hardening, secret management, automated patching, policy enforcement and secure CI/CD workflows.
        </p>
      </div>

      <div class="space-y-6 animate-fade-in-up stagger-3">
        <p class="text-sm font-mono text-steel-300 leading-relaxed">
          <span class="text-accent font-bold">></span> Experienced with AWS and hybrid environments. Service mesh and identity-aware network design.
        </p>

        <p class="text-sm font-mono text-steel-300 leading-relaxed">
          <span class="text-accent font-bold">></span> Deep knowledge in virtualization & Networking. Built zero-trust foundations.
        </p>

        <p class="text-sm font-mono text-steel-300 leading-relaxed">
          <span class="text-accent font-bold">></span> Strong background in observability: Prometheus, Grafana, ELK stack, uptime + alerting strategies.
        </p>

        <p class="text-sm font-mono text-steel-300 leading-relaxed">
          <span class="text-accent font-bold">></span> Infrastructure-as-code and automation using Ansible, Python, Bash, and Terraform. Designed for resilience & performance.
        </p>
      </div>
    </div>

    <div class="mt-12 flex gap-6 animate-fade-in-up stagger-4">
      <a
        href="/projects"
        class="px-8 py-3 bg-accent/10 border border-accent/30 text-accent font-mono text-sm rounded-lg hover:bg-accent/20 hover:border-accent/50 hover:shadow-glow transition-all duration-300"
      >
        View Projects
      </a>
      <a
        href="/contact"
        class="px-8 py-3 bg-steel-900/50 border border-steel-700 text-steel-200 font-mono text-sm rounded-lg hover:bg-steel-800/50 hover:border-steel-600 transition-all duration-300"
      >
        Get in Touch
      </a>
    </div>
  </section>
</BaseLayout>
