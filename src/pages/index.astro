---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="min-h-screen flex flex-col items-center justify-center px-6 md:px-12 py-16 gap-8 text-center">
    
    <!-- TÍTULO -->
    <h1 class="text-4xl md:text-6xl font-mono font-bold text-[#cccccc] animate-fade-in">
      isaac@quezada:~$
    </h1>

    <!-- DESCRIPCIÓN -->
    <p class="text-lg text-[#bbbbbb] max-w-2xl leading-relaxed animate-fade-in-up">
      I'm a DevOps engineer and cybersecurity specialist focused on automation, infrastructure hardening, and reliable systems. I build clean solutions, break weak ones, and move fast.
    </p>

    <!-- BOTONES -->
    <div class="flex flex-wrap justify-center gap-4 animate-fade-in-up">
      <a href="/cv.pdf" class="px-5 py-2 border border-[#999] text-[#ccc] hover:bg-[#ccc] hover:text-black transition">
        Download CV
      </a>
      <a href="/projects" class="px-5 py-2 border border-[#999] text-[#ccc] hover:bg-[#ccc] hover:text-black transition">
        View Projects
      </a>
      <a href="/contact" class="px-5 py-2 border border-[#999] text-[#ccc] hover:bg-[#ccc] hover:text-black transition">
        Contact Me
      </a>
    </div>

    <!-- QUICK FACTS -->
    <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-1 text-sm text-[#aaaaaa] max-w-3xl animate-fade-in-up text-left">
      <li>/ 15+ years working with Linux, open-source, and infrastructure.</li>
      <li>/ Strong background in automation, CI/CD, and system hardening.</li>
      <li>/ Focused on security, performance, and clean, resilient deployments.</li>
      <li>/ Freelance-friendly. Available for remote and contract work.</li>
      <li>/ Experience with AWS, Docker, Kubernetes, Ansible, Terraform, GitOps.</li>
    </ul>

    <!-- TERMINAL FAKE -->
    <div class="w-full max-w-xl border border-[#666] rounded-md bg-[#0a0a0a] shadow-lg font-mono text-sm animate-fade-in-up">
      <div class="flex items-center gap-2 px-3 py-2 border-b border-[#666] bg-[#1a1a1a] rounded-t-md">
        <span class="h-3 w-3 rounded-full bg-red-500"></span>
        <span class="h-3 w-3 rounded-full bg-yellow-500"></span>
        <span class="h-3 w-3 rounded-full bg-green-500"></span>
        <span class="text-xs text-[#888] ml-2">isaacquezada@localhost</span>
      </div>
      <div class="px-4 py-4 text-[#66ff99]">
        <p class="mb-1">$ curl -O https://isaacquezada.dev/cv.pdf</p>
        <p class="text-[#777]"># direct download.</p>
      </div>
    </div>

  </section>
</BaseLayout>
