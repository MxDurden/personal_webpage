---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <section class="min-h-screen flex flex-col justify-center items-center text-center px-4">
    <h1 class="text-5xl sm:text-6xl font-bold text-green-400 mb-4">
      Hi, I'm MrDurden
    </h1>
    <p class="text-xl sm:text-2xl text-gray-300 max-w-xl">
      Linuxero de guerra. DevSecOps. Hacker ético. Quebrando sistemas desde antes que fueran mainstream.
    </p>
    <div class="mt-8 flex flex-col sm:flex-row gap-4">
      <a href="/resume" class="bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded text-lg">
        Ver CV
      </a>
      <a href="/h4x0r" class="bg-gray-800 hover:bg-gray-700 text-white px-6 py-3 rounded text-lg border border-green-600">
        Entrar al Dungeon 🕳️
      </a>
    </div>
  </section>
</BaseLayout>
