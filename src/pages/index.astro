---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="min-h-screen flex flex-col justify-center">
    <h1 class="text-3xl md:text-5xl font-bold text-accent mb-4 animate-fade-in">
      ~$ welcome to bytefuck.club
    </h1>

    <p class="text-lg text-gray-400 mb-6 max-w-2xl animate-fade-in-up leading-relaxed">
      I'm a DevOps engineer and cybersecurity specialist focused on automation, infrastructure hardening, and systems reliability. I build clean solutions, break weak ones, and don't waste time.
    </p>

    <p class="text-md text-gray-500 mb-8 max-w-2xl animate-fade-in-up leading-relaxed">
      This site is my digital workspace. You’ll find my skills, past projects, and contact links. If you're hiring, freelancing, or looking for real technical expertise — start below.
    </p>

    <div class="flex flex-wrap gap-4 animate-fade-in-up">
      <a href="/cv.pdf" class="border border-accent text-accent px-4 py-2 hover:bg-accent hover:text-black transition">
        Download CV
      </a>
      <a href="/projects" class="border border-gray-600 text-gray-300 px-4 py-2 hover:bg-white hover:text-black transition">
        View Projects
      </a>
      <a href="/contact" class="border border-gray-600 text-gray-300 px-4 py-2 hover:bg-white hover:text-black transition">
        Contact Me
      </a>
    </div>

    <!-- 💻 Mini terminal block -->
    <div class="mt-8 max-w-fit border border-gray-700 rounded-md bg-[#0a0a0a] shadow-lg font-mono text-sm animate-fade-in-up">
  <div class="flex items-center gap-2 px-3 py-2 border-b border-gray-700 bg-[#1a1a1a] rounded-t-md">
    <span class="h-3 w-3 rounded-full bg-red-500"></span>
    <span class="h-3 w-3 rounded-full bg-yellow-500"></span>
    <span class="h-3 w-3 rounded-full bg-green-500"></span>
    <span class="text-xs text-gray-400 ml-2">bytefuck@localhost</span>
  </div>
  <div class="px-4 py-3 text-green-400">
    <p class="mb-1">$ curl -O https://bytefuck.club/cv.pdf</p>
    <p class="text-gray-500"># direct download.</p>
  </div>
</div>

  </section>
</BaseLayout>


