</div>

<!--  BLOQUE DE CIERRE -->
    <div class="mt-16 text-center text-gray-500 text-sm italic">
  <p>More details and project breakdowns available on request.</p>
  <p class="mt-2">Let’s build something secure and scalable — <a href="/contact" class="text-accent underline hover:text-white">get in touch</a>.</p>
</div>
  </section>
</BaseLayout>
