---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Experience | Isaac Quezada";
const description = "20+ years of technical roles across security, infrastructure, and automation in startups, enterprises, and freelance projects.";
---

<BaseLayout title={title} description={description}>
  <section class="min-h-screen px-6 py-12 text-white">
    <h1 class="text-4xl font-bold text-gray-100 mb-6">Experience</h1>
    <p class="text-lg text-gray-400 mb-8 max-w-2xl">
      Technical roles and contributions across security, infrastructure, and automation — spanning startups, enterprises, and freelance projects.
    </p>

    <div class="relative border-l border-gray-700 pl-6 space-y-12">


<div x-data="{ open: false }" class="relative ml-4 animate-fade-in-up transition-all duration-300">
  <div class="absolute w-4 h-4 bg-green-400 rounded-full -left-6 top-2 border-2 border-black"></div>

  <button @click="open = !open" class="text-left w-full group focus:outline-none">
    <h3 class="text-xl font-semibold text-gray-100 group-hover:text-accent transition">
      DevOps / Cloud Infrastructure Engineer
    </h3>
    <time class="block mb-1 text-sm text-gray-500">2021 – 2023</time>
    <p class="text-sm text-gray-500 italic mb-2">Enterprise Consulting • Global Clients in Finance & Aerospace</p>
  </button>

  <div x-show="open" x-transition class="overflow-hidden mt-2">
    <ul class="space-y-1">
      <template x-for="(item, index) in [
        'Supported infrastructure and DevOps workflows across multiple clients including USAA, Santander, and Bombardier.',
        'Performed large-scale application and infrastructure migrations between data centers and cloud environments.',
        'Patched and hardened Linux and Windows servers, remediating vulnerabilities and ensuring compliance baselines.',
        'Utilized Ansible for OS upgrades, application deployment automation, and system configuration management.',
        'Managed DNS, load balancers, certificates, and firewall rules as part of application lifecycle support.',
        'Worked with CI/CD pipelines using Git, Jenkins, and internal automation platforms for production releases.',
        'Collaborated with security teams to enforce access policies, audit logs, and implement monitoring rules.',
        'Handled troubleshooting of distributed systems in hybrid environments (on-prem + AWS).',
        'Documented operational runbooks and supported SRE workflows for reliability and incident response.',
        'Assisted in the development and implementation of infrastructure-as-code strategies across client stacks.'
      ]" :key="index">
        <li class="list-item-fade list-disc list-inside text-gray-400 text-base"
            :style="'animation-delay: ' + (index * 100) + 'ms'">
          <span x-text="item"></span>
        </li>
      </template>
    </ul>
  </div>
</div>


<div x-data="{ open: false }" class="relative ml-4 animate-fade-in-up transition-all duration-300">
  <div class="absolute w-4 h-4 bg-green-400 rounded-full -left-6 top-2 border-2 border-black"></div>

  <button @click="open = !open" class="text-left w-full group focus:outline-none">
    <h3 class="text-xl font-semibold text-gray-100 group-hover:text-accent transition">
      Global IT Operations Manager
    </h3>
    <time class="block mb-1 text-sm text-gray-500">2019 – 2021</time>
    <p class="text-sm text-gray-500 italic mb-2">India • US • UK • Mexico</p>
  </button>

  <div x-show="open" x-transition class="overflow-hidden mt-2">
    <ul class="space-y-1">
      <template x-for="(item, index) in [
        'Served as primary IT contact between India, Mexico, the US, and UK, coordinating infrastructure and compliance.',
        'Led internal IT team and managed global infrastructure supporting call center operations and backend services.',
        'Deployed and maintained hybrid environments with on-premise servers and cloud instances on AWS.',
        'Built and managed Galera clusters for high availability MySQL replication across regions.',
        'Implemented network segmentation, VPN tunnels, firewall rules, and Squid-based web filtering across offices.',
        'Set up and maintained PBX systems, internal VoIP infrastructure, and LAMP-stack application servers.',
        'Automated server provisioning and configuration tasks using Python and shell scripting.',
        'Coordinated development of an internal business support app, integrating DevOps practices for CI/CD pipelines.',
        'Oversaw virtualized infrastructure using Proxmox and KVM for internal services and staging environments.',
        'Handled procurement, vendor contracts, and housing of production servers in external datacenters.',
        'Maintained documentation, internal wikis, and cost reports for infrastructure and development ops.'
      ]" :key="index">
        <li class="list-item-fade list-disc list-inside text-gray-400 text-base"
            :style="'animation-delay: ' + (index * 100) + 'ms'">
          <span x-text="item"></span>
        </li>
      </template>
    </ul>
  </div>
</div>


<div x-data="{ open: false }" class="relative ml-4 animate-fade-in-up transition-all duration-300">
  <div class="absolute w-4 h-4 bg-green-400 rounded-full -left-6 top-2 border-2 border-black"></div>

  <button @click="open = !open" class="text-left w-full group focus:outline-none">
    <h3 class="text-xl font-semibold text-gray-100 group-hover:text-accent transition">
      IT Manager – Infrastructure & Security
    </h3>
    <time class="block mb-1 text-sm text-gray-500">2017 – 2019</time>
    <p class="text-sm text-gray-500 italic mb-2">National Logistics Company • Mexico</p>
  </button>

  <div x-show="open" x-transition class="overflow-hidden mt-2">
    <ul class="space-y-1">
      <template x-for="(item, index) in [
        'Led IT operations for a nationwide logistics firm with remote offices in every major port city.',
        'Managed a five-person internal team and coordinated external developers and system implementers.',
        'Oversaw hybrid infrastructure combining on-premise servers and AWS cloud services for critical applications.',
        'Maintained web servers, mail services, VPN access, and internal documentation tools including a self-hosted wiki.',
        'Implemented VLAN segmentation, firewall rules, Squid-based web filtering, and internal file-sharing protocols.',
        'Monitored infrastructure with Nagios and maintained PostgreSQL and MySQL databases across environments.',
        'Drove company-wide cybersecurity initiatives including endpoint protection, user training, and access control audits.',
        'Managed Odoo ERP deployments covering inventory, fleet management, HR, accounting, and procurement.',
        'Supervised the development of a mobile internal app (iOS/Android), coordinating with external dev teams.',
        'Handled hardware lifecycle management, vendor relations, internet service procurement, and network upgrades.'
      ]" :key="index">
        <li class="list-item-fade list-disc list-inside text-gray-400 text-base"
            :style="'animation-delay: ' + (index * 100) + 'ms'">
          <span x-text="item"></span>
        </li>
      </template>
    </ul>
  </div>
</div>


<div x-data="{ open: false }" class="relative ml-4 animate-fade-in-up transition-all duration-300">
  <div class="absolute w-4 h-4 bg-green-400 rounded-full -left-6 top-2 border-2 border-black"></div>

  <button @click="open = !open" class="text-left w-full group focus:outline-none">
    <h3 class="text-xl font-semibold text-gray-100 group-hover:text-accent transition">
      IT Manager
    </h3>
    <time class="block mb-1 text-sm text-gray-500">2015 – 2017</time>
    <p class="text-sm text-gray-500 italic mb-2">National Civil Engineering & Construction Firm • Mexico</p>
  </button>

  <div x-show="open" x-transition class="overflow-hidden mt-2">
    <ul class="space-y-1">
      <template x-for="(item, index) in [
        'Managed the entire IT department, overseeing network administration, cybersecurity, cloud systems, and end-user support.',
        'Implemented and maintained firewall rules, web filtering, and bandwidth controls to secure network traffic.',
        'Led infrastructure upgrades, including acquisition and deployment of new servers, workstations, and network equipment.',
        'Deployed and managed virtualized environments for database, application, and web hosting services.',
        'Supervised external developers and service providers for email hosting, ERP support, and custom software integrations.',
        'Implemented Odoo ERP modules for inventory, HR, fleet management, and procurement across departments.',
        'Administered Active Directory, VPN access, user provisioning, and access control policies.',
        'Ensured data integrity through endpoint protection, secure backups, and internal access controls.',
        'Coordinated software licensing, asset inventory, and IT vendor contracts across regional offices.'
      ]" :key="index">
        <li class="list-item-fade list-disc list-inside text-gray-400 text-base"
            :style="'animation-delay: ' + (index * 100) + 'ms'">
          <span x-text="item"></span>
        </li>
      </template>
    </ul>
  </div>
</div>



<div x-data="{ open: false }" class="relative ml-4 animate-fade-in-up transition-all duration-300">
  <div class="absolute w-4 h-4 bg-green-400 rounded-full -left-6 top-2 border-2 border-black"></div>

  <button @click="open = !open" class="text-left w-full group focus:outline-none">
