---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts', ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });

  const tags = [...new Set(allPosts.flatMap(post => post.data.tags))];

  return tags.map(tag => {
    const filteredPosts = allPosts
      .filter(post => post.data.tags.includes(tag))
      .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

    return {
      params: { tag },
      props: { posts: filteredPosts, tag },
    };
  });
}

const { posts, tag } = Astro.props;

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  }).format(date);
};

const categoryColors = {
  tech: "text-accent border-accent/30 bg-accent/10",
  notes: "text-blue-400 border-blue-400/30 bg-blue-400/10",
  life: "text-purple-400 border-purple-400/30 bg-purple-400/10",
};
---

<BaseLayout>
  <section class="container mx-auto px-6 md:px-12 py-12">
    <div class="max-w-6xl mx-auto">
      <header class="mb-12">
        <div class="mb-4">
          <a
            href="/blog"
            class="text-sm font-mono text-steel-500 hover:text-accent transition-colors"
          >
            ← Back to Blog
          </a>
        </div>

        <div class="flex items-center gap-4 mb-4">
          <h1 class="text-4xl md:text-5xl font-bold text-steel-100 font-mono">
            <span class="text-accent">#</span>{tag}
          </h1>
          <span class="px-4 py-2 rounded-lg border border-steel-800 bg-steel-900/50 text-steel-300 font-mono text-sm">
            {posts.length} {posts.length === 1 ? 'post' : 'posts'}
          </span>
        </div>

        <p class="text-lg text-steel-300">
          All posts tagged with "{tag}".
        </p>
      </header>

      <div class="space-y-6">
        {posts.map((post) => (
          <article class="p-6 bg-carbon/50 border border-steel-900 rounded-lg hover:border-steel-700 transition-all duration-300">
            <div class="flex flex-wrap gap-3 items-center mb-3 text-sm">
              <a
                href={`/blog/category/${post.data.category}`}
                class={`px-3 py-1 rounded-lg border font-mono transition-all duration-200 hover:scale-105 ${categoryColors[post.data.category]}`}
              >
                {post.data.category}
              </a>
              <span class="text-steel-500">•</span>
              <time datetime={post.data.pubDate.toISOString()} class="text-steel-500 font-mono">
                {formatDate(post.data.pubDate)}
              </time>
            </div>

            <h2 class="text-2xl font-bold text-steel-100 mb-3 font-mono">
              <a href={`/blog/${post.slug}`} class="hover:text-accent transition-colors">
                {post.data.title}
              </a>
            </h2>

            <p class="text-steel-300 mb-4 leading-relaxed">
              {post.data.description}
            </p>

            <div class="flex flex-wrap gap-2">
              {post.data.tags.map((postTag) => (
                <a
                  href={`/blog/tag/${postTag}`}
                  class={`px-2 py-1 text-xs font-mono bg-steel-900/50 border border-steel-800 rounded hover:border-accent/50 transition-all duration-200 ${
                    postTag === tag ? 'text-accent border-accent/50' : 'text-steel-500 hover:text-accent'
                  }`}
                >
                  #{postTag}
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
