---
import "../styles/global.css";
import Navbar from '../components/Navbar.astro';
import Footer from "../components/Footer.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body class="bg-[#0a0a0a] text-[#e0e0e0] font-mono animate-fade-in">
    <header class="shadow-sm animate-slide-down bg-black/80 backdrop-blur">
  <div class="max-w-7xl mx-auto px-4">
    <Navbar />
  </div>
</header>
    <div class="min-h-screen flex flex-col justify-between max-w-7xl mx-auto px-4">
  <main class="pt-16 pb-6">
    <slot />
  </main>
  <Footer />
</div>
</html>
